{
  "name": "todo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run",
    "e2e": "npm run build && start-server-and-test preview http://localhost:4173/todo/dist/ 'cypress run'",
    "e2e:deployed": "cypress run --config baseUrl=https://andrii91.github.io/todo/dist/"
  },
  "dependencies": {
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.0",
    "cypress": "^15.16.0",
    "jsdom": "^29.1.1",
    "sass": "^1.100.0",
    "start-server-and-test": "^3.0.7",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.5"
  }
}
